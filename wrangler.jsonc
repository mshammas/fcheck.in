{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fcheck-in",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],

  // `main` and `assets` are deliberately absent: @astrojs/cloudflare drives
  // @cloudflare/vite-plugin, which builds the worker entry and static assets
  // and writes the deploy config itself. Setting them here makes `astro sync`
  // fail before the first build, when dist/ does not yet exist.

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fcheck",
      "database_id": "401c7e62-024e-4df0-a51d-e24a802d9418",
      "migrations_dir": "migrations"
    }
  ],

  // Semantic claim matching (docs/setup.md). Left commented until the Vectorize
  // index is provisioned — the code falls back to hash + FTS when these bindings
  // are absent, and an unbound Vectorize index would otherwise break `wrangler
  // dev`. To enable: run `wrangler vectorize create fcheck-claims
  // --dimensions=768 --metric=cosine`, then uncomment both bindings.
  // "ai": { "binding": "AI" },
  // "vectorize": [
  //   { "binding": "CLAIM_VECTORS", "index_name": "fcheck-claims" }
  // ],

  // Secrets (ANTHROPIC_API_KEY, GOOGLE_FACT_CHECK_API_KEY) come from .dev.vars
  // locally and `wrangler secret put` in production. Never put them here.
  //
  // CF_ACCESS_* are not secrets — they identify the Access application, and
  // admin auth fails closed without them. ADMIN_DEV_EMAIL is the local-only
  // admin identity; src/lib/auth.ts ignores it unless ENVIRONMENT is exactly
  // "development", so the staging and production blocks below can never use it.
  "vars": {
    "ENVIRONMENT": "development",
    "ADMIN_DEV_EMAIL": "editorial@fcheck.in"
  },

  "env": {
    "staging": {
      "name": "fcheck-in-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        // From: Cloudflare dashboard → Zero Trust → Access → Applications
        "CF_ACCESS_TEAM_DOMAIN": "PLACEHOLDER.cloudflareaccess.com",
        "CF_ACCESS_AUD": "PLACEHOLDER_ACCESS_APPLICATION_AUD"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fcheck-staging",
          "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
