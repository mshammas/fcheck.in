{
  "name": "fcheck.in",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "CLOUDFLARE_ENV=production astro build && wrangler deploy --env production",
    "deploy:staging": "CLOUDFLARE_ENV=staging astro build && wrangler deploy --env staging",
    "check": "wrangler types && astro check",
    "check:docs": "node scripts/check-docs.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply fcheck --local",
    "db:migrate:remote": "wrangler d1 migrations apply fcheck --remote",
    "db:migrate:staging": "wrangler d1 migrations apply fcheck-staging --remote --env staging",
    "db:query": "wrangler d1 execute fcheck --local --command",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@astrojs/cloudflare": "^14.1.7",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "better-sqlite3": "^13.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "vite": "8.2.0",
    "rolldown": "1.2.1"
  }
}
