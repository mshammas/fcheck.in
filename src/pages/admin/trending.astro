---
/**
 * Trending queue management — pinned cards, the time-limited approved queue,
 * and candidates awaiting approval. Ported from wireframes/admin.html.
 */
import AdminBase from '../../layouts/AdminBase.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { getDb } from '../../lib/db/client';
import { getTrendingQueue, getTrendingCandidates } from '../../lib/db/admin';
import type { SourceType, Verdict } from '../../lib/types';

export const prerender = false;

const db = getDb();
const [queue, candidates] = await Promise.all([getTrendingQueue(db), getTrendingCandidates(db, 12)]);

const pinned = queue.filter((c: any) => c.pinned === 1);
const active = queue.filter((c: any) => c.pinned === 0);
const TRENDING_MIN = 10;

function expiresIn(iso: string | null): { text: string; warn: boolean } | null {
  if (!iso) return null;
  const hrs = Math.round((Date.parse(iso) - Date.now()) / 3600000);
  if (hrs <= 0) return { text: 'expired', warn: true };
  return { text: `expires in ${hrs}h`, warn: hrs <= 6 };
}

function cardUrl(row: any): string {
  return row.source_type === 'original' && row.slug ? `/article/${row.slug}` : `/check/${row.claim_id}`;
}
---

<AdminBase title="Trending Queue" active="trending">
  {
    active.length < TRENDING_MIN && (
      <div class="banner">
        ⚠ Queue running low — {active.length} time-limited card{active.length === 1 ? '' : 's'} live.
        Recommended minimum is {TRENDING_MIN}. Approve candidates below.
      </div>
    )
  }

  <section class="block">
    <h2 class="block-title">📌 Pinned — always live, no expiry</h2>
    {
      pinned.length === 0 ? (
        <p class="empty">No pinned cards. Pin a card to keep it in rotation indefinitely.</p>
      ) : (
        <ul class="card-list">
          {pinned.map((c: any) => (
            <li class="tcard" data-card-id={c.card_id}>
              <span class="pin-icon" aria-hidden="true">📌</span>
              <div class="tcard-main">
                <a class="tcard-hl" href={cardUrl(c)} target="_blank" rel="noopener">{c.headline}</a>
                <div class="tcard-meta">
                  <VerdictBadge verdict={c.verdict as Verdict} size="sm" />
                  <SourceBadge name={c.fact_checker_name} tier={c.fact_checker_tier} />
                </div>
              </div>
              <div class="tcard-actions">
                <button type="button" class="mini" data-action="unpin">Unpin</button>
                <button type="button" class="mini danger" data-action="remove">Remove</button>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="block">
    <h2 class="block-title">Approved queue</h2>
    <p class="block-hint">48-hour countdown from approval · head of queue pops first when expired</p>
    {
      active.length === 0 ? (
        <p class="empty">No time-limited cards in rotation. Approve candidates below to fill the queue.</p>
      ) : (
        <ul class="card-list">
          {active.map((c: any, i: number) => {
            const exp = expiresIn(c.expires_at);
            return (
              <li class="tcard" data-card-id={c.card_id}>
                <span class="pos">{i + 1}</span>
                <div class="tcard-main">
                  <a class="tcard-hl" href={cardUrl(c)} target="_blank" rel="noopener">{c.headline}</a>
                  <div class="tcard-meta">
                    <VerdictBadge verdict={c.verdict as Verdict} size="sm" />
                    <SourceBadge name={c.fact_checker_name} tier={c.fact_checker_tier} />
                    {exp && <span class:list={['exp', { warn: exp.warn }]}>{exp.warn ? '⚠ ' : ''}{exp.text}</span>}
                  </div>
                </div>
                <div class="tcard-actions">
                  <button type="button" class="mini" data-action="pin">📌 Pin</button>
                  <button type="button" class="mini danger" data-action="remove">×</button>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section class="block">
    <h2 class="block-title">Candidates awaiting approval</h2>
    <p class="block-hint">Surfaced by submission volume, recency &amp; verdict weight · TYPE 1 and TYPE 2 only</p>
    {
      candidates.length === 0 ? (
        <p class="empty">No eligible candidates. Published TYPE 1 and TYPE 2 claims not already in the queue appear here.</p>
      ) : (
        <ul class="card-list">
          {candidates.map((c) => (
            <li class="tcard candidate" data-claim-id={c.claim_id}>
              <div class="subs">
                <span class="subs-num">{c.submission_count}</span>
                <span class="subs-cap">subs</span>
              </div>
              <div class="tcard-main">
                <span class="tcard-hl">{c.headline}</span>
                <div class="tcard-meta">
                  <VerdictBadge verdict={c.verdict} size="sm" />
                  <SourceBadge name={c.fact_checker_name} tier={c.source_type === 'external' ? null : null} />
                </div>
              </div>
              <div class="tcard-actions">
                <button type="button" class="mini approve" data-action="approve">✓ Approve</button>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</AdminBase>

<style>
  .banner {
    background: var(--alert-bg);
    border: 1px solid var(--alert-border);
    color: var(--alert-text);
    border-radius: var(--r);
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 22px;
  }

  .block {
    margin-bottom: 28px;
  }

  .block-title {
    font-family: var(--font-brand);
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .block-hint {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tcard {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: var(--shadow-sm);
  }

  .pin-icon {
    font-size: 16px;
  }

  .pos {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 14px;
    color: var(--text-muted);
    width: 20px;
    text-align: center;
    flex-shrink: 0;
  }

  .subs {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 44px;
    flex-shrink: 0;
  }

  .subs-num {
    font-family: var(--font-brand);
    font-weight: 800;
    font-size: 16px;
  }

  .subs-cap {
    font-size: 10px;
    color: var(--text-muted);
  }

  .tcard-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tcard-hl {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 14px;
    color: var(--text-primary);
    text-decoration: none;
  }

  a.tcard-hl:hover {
    color: var(--brand-dark);
  }

  .tcard-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .exp {
    font-size: 11px;
    color: var(--text-muted);
  }

  .exp.warn {
    color: #b45309;
    font-weight: 600;
  }

  .tcard-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .mini {
    font-size: 12px;
    font-weight: 600;
    padding: 6px 11px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
  }

  .mini:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .mini.danger {
    color: #b91c1c;
    border-color: #fecaca;
  }

  .mini.danger:hover {
    background: #fef2f2;
    border-color: #fca5a5;
  }

  .mini.approve {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }

  .mini.approve:hover {
    background: var(--brand-dark);
  }

  .empty {
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--r);
    padding: 20px;
    text-align: center;
    font-size: 13px;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .tcard {
      flex-wrap: wrap;
    }

    .tcard-actions {
      width: 100%;
    }

    .mini {
      flex: 1;
    }
  }
</style>

<script>
  async function act(url: string, method: string, body?: unknown): Promise<boolean> {
    const res = await fetch(url, {
      method,
      headers: body ? { 'content-type': 'application/json' } : {},
      body: body ? JSON.stringify(body) : undefined,
    });
    if (!res.ok) {
      const b = (await res.json().catch(() => null)) as { error?: string; url?: string } | null;
      alert(b?.error || `Action failed (${res.status})`);
      return false;
    }
    return true;
  }

  document.querySelectorAll<HTMLButtonElement>('.tcard-actions button').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('.tcard') as HTMLElement;
      const action = btn.dataset.action!;
      const cardId = card.dataset.cardId;
      const claimId = card.dataset.claimId;

      btn.disabled = true;
      let ok = false;

      if (action === 'approve' && claimId) {
        ok = await act('/api/admin/trending', 'POST', { claim_id: claimId });
      } else if (action === 'remove' && cardId) {
        ok = await act(`/api/admin/trending/${cardId}`, 'DELETE');
      } else if ((action === 'pin' || action === 'unpin') && cardId) {
        ok = await act(`/api/admin/trending/${cardId}`, 'PATCH', { pinned: action === 'pin' });
      }

      // Reload so pinned/queue sections and counts re-sort correctly.
      if (ok) window.location.reload();
      else btn.disabled = false;
    });
  });
</script>
