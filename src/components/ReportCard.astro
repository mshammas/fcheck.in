---
/**
 * Editorial-grid report card.
 *
 * Like TrendingCard but sized for the responsive "Latest Reports" grid rather
 * than the horizontal rail, and carrying data-categories / data-region so the
 * client-side sidebar filters can show and hide it without a round-trip.
 */
import type { SourceType, Verdict } from '../lib/types';
import VerdictBadge from './VerdictBadge.astro';
import SourceBadge from './SourceBadge.astro';

interface Props {
  headline: string;
  verdict: Verdict | null;
  sourceType: SourceType;
  url: string;
  publishedAt: string | null;
  attribution?: { name: string; tier: 1 | 2 | null } | null;
  categories: string[];
  region: string;
}

const { headline, verdict, sourceType, url, publishedAt, attribution = null, categories, region } = Astro.props;
const isOwn = sourceType === 'original';
const date = publishedAt ? relativeDate(publishedAt) : null;

function relativeDate(iso: string): string {
  const then = Date.parse(iso);
  if (Number.isNaN(then)) return '';
  const hours = Math.round((Date.now() - then) / 3_600_000);
  if (hours < 1) return 'just now';
  if (hours < 24) return `${hours}h ago`;
  const days = Math.round(hours / 24);
  if (days < 30) return `${days}d ago`;
  return new Date(then).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---

<a
  class:list={['rcard', isOwn ? 'own' : 'ext']}
  href={url}
  data-report-card
  data-categories={categories.join('|')}
  data-region={region}
>
  <div class="rcard-img" aria-hidden="true"><span>{isOwn ? '✓' : '⬢'}</span></div>
  <div class="rcard-body">
    <VerdictBadge verdict={verdict} size="sm" />
    <h3 class="rcard-hl">{headline}</h3>
    <div class="rcard-foot">
      <SourceBadge name={attribution?.name ?? null} tier={attribution?.tier ?? null} />
      {date && <span class="rcard-date">{date}</span>}
    </div>
  </div>
</a>

<style>
  .rcard {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s;
  }

  .rcard:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  .rcard.own:hover { border-color: var(--brand-mid); }
  .rcard.ext:hover { border-color: var(--type-2-bd); }

  .rcard-img {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .own .rcard-img { background: linear-gradient(135deg, var(--brand-light) 0%, #CCFBF1 100%); color: var(--brand); }
  .ext .rcard-img { background: linear-gradient(135deg, var(--type-2-bg) 0%, var(--type-2-bd) 100%); color: var(--type-2-text); }

  .rcard-body { padding: 14px; display: flex; flex-direction: column; gap: 9px; flex: 1; }

  .rcard-hl {
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rcard-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
  }

  .rcard-date { font-size: 11px; color: var(--text-muted); white-space: nowrap; }
</style>
