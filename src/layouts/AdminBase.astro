---
/**
 * Admin shell — dark sidebar, topbar, content area.
 *
 * The wireframe (wireframes/admin.html) switched "screens" with a client-side
 * showScreen() and lived on one page. Here each screen is a real route, so the
 * sidebar links are hrefs and the active item is decided server-side from the
 * current path. Mobile rules folded in from wireframes/mobile-admin.html.
 *
 * Reachable only behind the auth middleware, which sets Astro.locals.admin.
 */
import type { AdminUser } from '../lib/types';
import { getDb } from '../lib/db/client';

interface NavItem {
  href: string;
  icon: string;
  label: string;
  badge?: { text: string; warn?: boolean };
}

interface Props {
  title: string;
  active: string;
}

const admin = Astro.locals.admin as AdminUser | undefined;
const currentPath = Astro.url.pathname;

const { title, active } = Astro.props;

const roleLabel = admin
  ? { super_admin: 'Super Admin', editor: 'Editor', reviewer: 'Reviewer' }[admin.role]
  : '';
const initial = admin?.name?.[0]?.toUpperCase() ?? '?';

// Live badge counts so every page shows the same, accurate queue state.
const db = getDb();
// Draft count uses the same report-based predicate as the queue itself
// (src/lib/db/admin.ts → PENDING_DRAFT_PREDICATE) so the badge and the queue
// never disagree — including for TYPE 3→2 promoted claims.
const badges = await db
  .prepare(
    `SELECT
       (SELECT COUNT(*) FROM claims c
        WHERE EXISTS (SELECT 1 FROM reports rp WHERE rp.claim_id = c.id AND rp.report_type = 'preliminary')
          AND NOT EXISTS (SELECT 1 FROM reports ro WHERE ro.claim_id = c.id AND ro.report_type = 'original')
          AND c.status != 'rejected') AS drafts,
       (SELECT COUNT(*) FROM trending_cards WHERE pinned=0 AND (expires_at IS NULL OR expires_at > ?)) AS trending`
  )
  .bind(new Date().toISOString())
  .first<{ drafts: number; trending: number }>();

const draftCount = badges?.drafts ?? 0;
const trendingActive = badges?.trending ?? 0;
const TRENDING_LOW = 5; // admin gets a low-queue warning below this

const mainNav: NavItem[] = [
  { href: '/admin', icon: '📊', label: 'Overview' },
  {
    href: '/admin/drafts',
    icon: '📝',
    label: 'Draft Queue',
    ...(draftCount > 0 ? { badge: { text: String(draftCount) } } : {}),
  },
  {
    href: '/admin/trending',
    icon: '🔥',
    label: 'Trending Queue',
    ...(trendingActive < TRENDING_LOW ? { badge: { text: `⚠ ${trendingActive}`, warn: true } } : {}),
  },
];

function isActive(item: NavItem): boolean {
  if (item.href === '/admin') return active === 'overview';
  return currentPath === item.href || currentPath.startsWith(`${item.href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — fcheck.in admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-logo">
        <span class="logo-mark" aria-hidden="true">✓</span>
        <span class="logo-text-wrap">
          <span class="logo-name">f<span>check</span>.in</span>
          <span class="logo-admin">Admin Panel</span>
        </span>
      </div>

      <nav class="sidebar-nav" aria-label="Admin">
        <div class="nav-section-label">Main</div>
        {
          mainNav.map((item) => (
            <a class:list={['nav-item', { active: isActive(item) }]} href={item.href}>
              <span class="nav-icon" aria-hidden="true">{item.icon}</span>
              {item.label}
              {item.badge && (
                <span class:list={['nav-badge', { warn: item.badge.warn }]}>{item.badge.text}</span>
              )}
            </a>
          ))
        }

        <div class="nav-section-label">Site</div>
        <a class="nav-item" href="/" target="_blank" rel="noopener">
          <span class="nav-icon" aria-hidden="true">↗</span> View public site
        </a>
      </nav>

      <div class="sidebar-user">
        <span class="user-avatar" aria-hidden="true">{initial}</span>
        <span class="user-info">
          <span class="user-name">{admin?.name ?? 'Unknown'}</span>
          <span class="user-role">{roleLabel}</span>
        </span>
      </div>
    </aside>

    <div class="main">
      <header class="topbar">
        <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Toggle navigation">☰</button>
        <h1 class="topbar-title">{title}</h1>
        <div class="topbar-actions">
          <slot name="actions" />
        </div>
      </header>

      <main class="content">
        <slot />
      </main>
    </div>

    <style>
      :root {
        --brand: #0d9488;
        --brand-dark: #0f766e;
        --brand-light: #f0fdfa;
        --brand-mid: #99f6e4;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #94a3b8;
        --border: #e2e8f0;
        --surface: #ffffff;
        --bg: #f8fafc;
        --sidebar-bg: #0f172a;
        --sidebar-text: #94a3b8;
        --sidebar-hover: #1e293b;
        --sidebar-active: #1e293b;
        --alert-bg: #fffbeb;
        --alert-border: #fde68a;
        --alert-text: #92400e;
        --info-bg: #eff6ff;
        --info-border: #bfdbfe;
        --info-text: #1e40af;
        --success-bg: #f0fdf4;
        --success-border: #bbf7d0;
        --success-text: #15803d;
        --font-brand: 'Plus Jakarta Sans', system-ui, sans-serif;
        --font-body: 'Inter', system-ui, sans-serif;
        --r: 10px;
        --r-sm: 6px;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.07);
        --shadow: 0 4px 12px rgba(0, 0, 0, 0.07);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-body);
        color: var(--text-primary);
        background: var(--bg);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        width: 240px;
        flex-shrink: 0;
        background: var(--sidebar-bg);
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        z-index: 100;
      }

      .sidebar-logo {
        padding: 20px;
        border-bottom: 1px solid #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .logo-mark {
        width: 28px;
        height: 28px;
        background: var(--brand);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        flex-shrink: 0;
      }

      .logo-text-wrap {
        display: flex;
        flex-direction: column;
      }

      .logo-name {
        font-family: var(--font-brand);
        font-weight: 800;
        font-size: 16px;
        color: #fff;
        line-height: 1;
      }

      .logo-name span {
        color: var(--brand);
      }

      .logo-admin {
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        margin-top: 3px;
      }

      .sidebar-nav {
        flex: 1;
        padding: 12px 10px;
        overflow-y: auto;
      }

      .nav-section-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #475569;
        padding: 12px 10px 6px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: var(--r-sm);
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        color: var(--sidebar-text);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        margin-bottom: 1px;
        position: relative;
      }

      .nav-item:hover {
        background: var(--sidebar-hover);
        color: #fff;
      }

      .nav-item.active {
        background: var(--sidebar-active);
        color: #fff;
      }

      .nav-item.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 6px;
        bottom: 6px;
        width: 3px;
        background: var(--brand);
        border-radius: 0 2px 2px 0;
      }

      .nav-icon {
        font-size: 16px;
        flex-shrink: 0;
        width: 20px;
        text-align: center;
      }

      .nav-badge {
        margin-left: auto;
        font-size: 11px;
        font-weight: 700;
        background: var(--brand);
        color: #fff;
        border-radius: 10px;
        padding: 1px 7px;
        flex-shrink: 0;
      }

      .nav-badge.warn {
        background: #d97706;
      }

      .sidebar-user {
        padding: 14px 16px;
        border-top: 1px solid #1e293b;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--brand);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
      }

      .user-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .user-name {
        font-size: 13px;
        font-weight: 600;
        color: #fff;
      }

      .user-role {
        font-size: 11px;
        color: #64748b;
      }

      .main {
        margin-left: 240px;
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-width: 0;
      }

      .topbar {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0 28px;
        height: 56px;
        display: flex;
        align-items: center;
        gap: 14px;
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 20px;
        cursor: pointer;
        color: var(--text-secondary);
      }

      .topbar-title {
        font-family: var(--font-brand);
        font-weight: 700;
        font-size: 18px;
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
      }

      .content {
        padding: 28px;
        flex: 1;
        max-width: 1200px;
        width: 100%;
      }

      @media (max-width: 860px) {
        .menu-toggle {
          display: block;
        }

        .sidebar {
          transform: translateX(-100%);
          transition: transform 0.2s ease;
          box-shadow: var(--shadow);
        }

        .sidebar.open {
          transform: translateX(0);
        }

        .main {
          margin-left: 0;
        }

        .content {
          padding: 18px 16px;
        }
      }
    </style>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const sidebar = document.getElementById('sidebar');
      toggle?.addEventListener('click', () => sidebar?.classList.toggle('open'));
      // Tapping outside the drawer closes it on mobile.
      document.querySelector('.main')?.addEventListener('click', () => sidebar?.classList.remove('open'));
    </script>
  </body>
</html>

<style is:global>
  a {
    color: var(--brand);
  }
</style>
