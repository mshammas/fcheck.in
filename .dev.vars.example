# Copy to .dev.vars and fill in. .dev.vars is gitignored — never commit real keys.
# In production these are set with: wrangler secret put <NAME>

# Anthropic — claim extraction (Haiku 4.5) and AI deep-check (Sonnet 5)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Fact Check Tools API — external fact-checker search (TYPE 2)
# https://console.cloud.google.com → enable "Fact Check Tools API" → create API key
GOOGLE_FACT_CHECK_API_KEY="AIza..."

# Admin auth: nothing needed here for local dev. /admin uses the ADMIN_DEV_EMAIL
# bypass from wrangler.jsonc (only active when ENVIRONMENT=development). In
# staging/production, Cloudflare Access supplies the identity — set
# CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD in the wrangler env block, not here.

# Background jobs: shared bearer secret for POST /api/jobs/:job. The cron worker
# sends it; without it the job endpoints are inert (503). Any long random string.
CRON_SECRET="dev-cron-secret-change-me"

# Subscriber email notifications (optional). Without all three, the send path is
# inert — subscriptions are recorded but nothing is marked notified, so the
# backlog delivers once these are set. Shape matches Resend and similar.
# EMAIL_API_URL="https://api.resend.com/emails"
# EMAIL_API_TOKEN="re_..."
# EMAIL_FROM="fcheck.in <noreply@fcheck.in>"
